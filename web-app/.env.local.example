# Copy to .env.local — never commit .env.local
# Same Supabase project as `frontend/` (mobile) and `admin/` — web-app reads
# and writes the same tables (sessions, volunteer_feedback, shop_orders,
# events, court_orders), so live data here is live everywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set true for local UI work without Supabase Auth wired up yet (skips the
# admin-role check in server actions; pages still fall back to mock data
# automatically when a table is empty).
BYPASS_AUTH=true

# Optional — session approve/decline + event at-risk-volunteer emails soft-fail
# (log + skip) when unset, same as `admin/.env.local`.
RESEND_API_KEY=
EMAIL_FROM=noreply@cleanupgiveback.org

# Optional — powers Generate Letterhead (single + bulk PDF) in the session
# preview drawer, proxied to the same `backend/sessions` service admin uses.
# Without these, the letterhead buttons show a "not configured" message.
SESSIONS_API_URL=
ADMIN_API_KEY=

# Optional — Google Places suggestions on the event form. When unset, you can
# still type any address; create/update geocodes a map pin via Nominatim (OSM)
# so EventLocationMap works for every venue, not only pre-seeded Des Plaines.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
